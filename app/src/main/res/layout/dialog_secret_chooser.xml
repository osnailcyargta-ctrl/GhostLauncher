<?xml version="1.0" encoding="utf-8"?>
<!-- Secret popup shown when Ctrl+Alt+M is pressed.
     Has 2 big options:
     1. Hide App (manage hidden list)
     2. Open Hidden Apps (launch hidden apps) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_card"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/secret_title"
        style="@style/TextAppearance.App.Title"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="@string/secret_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Option 1: Hide App (manage hidden list) -->
    <LinearLayout
        android:id="@+id/btnHideApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chooser_glass"
        android:clickable="true"
        android:focusable="true"
        android:padding="18dp"
        android:elevation="0dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_view"
            android:tint="@color/accent"
            app:shapeAppearanceOverlay="@style/Widget.App.IconFrame"
            app:strokeColor="#1AFFFFFF"
            app:strokeWidth="0.5dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/secret_option_hide"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/secret_option_hide_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="@color/text_tertiary"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <!-- Option 2: Open Hidden Apps -->
    <LinearLayout
        android:id="@+id/btnOpenHidden"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chooser_glass"
        android:clickable="true"
        android:focusable="true"
        android:padding="18dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="@color/accent"
            app:shapeAppearanceOverlay="@style/Widget.App.IconFrame"
            app:strokeColor="#1AFFFFFF"
            app:strokeWidth="0.5dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/secret_option_open"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/openHiddenDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/secret_option_open_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="@color/text_tertiary"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Hint -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/secret_hint_dismiss"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp" />

</LinearLayout>
