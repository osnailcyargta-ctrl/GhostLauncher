<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/settings_appearance">
        <SwitchPreferenceCompat
            android:key="show_labels"
            android:defaultValue="true"
            android:title="@string/settings_show_labels" />
        <ListPreference
            android:key="grid_columns"
            android:title="@string/settings_grid"
            android:defaultValue="5"
            android:entries="@array/grid_columns_entries"
            android:entryValues="@array/grid_columns_values" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_about">
        <Preference
            android:key="about"
            android:title="@string/settings_about"
            android:summary="@string/settings_about_summary" />
    </PreferenceCategory>

</PreferenceScreen>
